function mark_message() {
    if [[ "$1" == "--unread" ]]; then
	local -n id_arr=UHTL
    elif [[ "$1" == "--inbox" ]]; then
	local -n id_arr=IHTL
    fi
    local -i index=$(rel_msg_index $IAC)
    local -i msg_id=${id_arr[index]}

    if test -v marked_messages[$msg_id]; then
	unset 'marked_messages[$msg_id]'
	unmark_message
    else
	# No value needed. Just need to let bash know it's defined
	marked_messages[$msg_id]=
	draw_marked_symbol
    fi
    local arr_str="${!marked_messages[@]}"
    marked_str="${arr_str// /,}"
}

function check_if_marked() {
    # Tester function use in highlight()
    [ -v marked_messages["$1"] ] && return 0 || return -1;
}

function draw_marked_symbol() {
    reset_colors
    echo -en "$W*"
    set_cursor $LP 0
    reset_colors
}

function unmark_message() {
    reset_colors
    echo -n " "
    set_cursor $LP 0
}

function archive_marked_messages() {
    draw_popup "Archiving selected messages"
    clearfifo
    echo "$A MOVE $marked_str ${folder[archived]}" >&$sendfd
    while read -r line; do
	if [[ "$line" =~ " OK " ]]; then break; fi
	if [[ "$line" =~ " BAD "|" NO " ]]; then
	    draw_popup --warn --restore $1 "Failed to archive messages"
	    return
	fi
    done <&$readfd
    reset_indexes marked_messages
    [ "$1" == "--unread" ] && refresh_unread
    [ "$1" == "--inbox" ] && switch_to_inbox
}

function delete_marked_messages() {
    draw_popup "Deleting selected messages"
    clearfifo
    echo "$A MOVE $marked_str ${folder[trash]}" >&$sendfd
    while read -r line; do
	if [[ "$line" =~ .*Success.*|" OK " ]]; then break; fi
	if [[ "$line" =~ " BAD "|" NO " ]]; then
	    draw_popup --warn --restore $1 "Failed to delete messages"
	    return
	fi
    done <&$readfd
    reset_indexes marked_messages
    [ "$1" == "--unread" ] && refresh_unread
    [ "$1" == "--inbox" ] && switch_to_inbox
}

function sort_array() {
    local -n arr=$1
    local flags=$2
    readarray -t sorted < <(printf '%s\n' "${arr[@]}"|sort $flags)
    echo "${sorted[*]}"
}

