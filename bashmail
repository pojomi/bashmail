#			       MESSAGE PROCESSING				#
#################################################################################

function get_mime_structure() {
    # $1 --unread or --inbox
    # $2 $UHTL or $IHTL
    clearfifo
    local -n id_arr=$2
    selected_message=${id_arr[$(rel_msg_index $IAC)]}
    local -A structure
    response=""; container=""; parens=""
    local -i paren_count
    structure[id]="$selected_message"
    structure[encoding]="none"
    echo "$A FETCH $selected_message BODYSTRUCTURE" >&$sendfd
    while read -r line; do
	if [[ "$line" =~ " OK " ]]; then break; fi
	if [[ "$line" =~ " BAD "|" NO " ]]; then
	    draw_popup --warn --restore $1 "Failed to get message structure"
	fi
	response+="$line"
    done <&$readfd
    # [1] is the parens. [2] is the format. [3] is the rest of the container.
    if [[ "$response" =~ BODYSTRUCTURE[^\(]*(\({1,})([^ ]{1,}" "[^ ]{1,})([^\)]*\)){2} ]]; then
	parens="${breg[1]}"
	structure[format]="${breg[2]}"
	container="${breg[*]:2:2}"
    fi
    [[ "$container" =~ Quoted-Printable|QUOTED-PRINTABLE ]] && structure[encoding]="qp"
    if (( ${#parens} > 0 )); then
	paren_count=$(( ${#parens}-1 ))
	(( paren_count == 3 )) && structure[leaf]="1.1.1"
	(( paren_count == 2 )) && structure[leaf]="1.1"
	(( paren_count == 1 )) && structure[leaf]="1"
    fi
    if [[ "${structure[format]}" =~ [Hh][Tt][Mm][Ll] ]]; then
	draw_popup --warn --restore $1 "HTML is not yet supported"
	return
    fi

    get_message $1 structure
}

function get_message() {
    # $1: --unread or --inbox
    # $2: AA structure
    local -n struct=$2
    local -i count=0
    echo "$A FETCH ${struct[id]} body.peek[${struct[leaf]}]" >&$sendfd
    read -r bytes <&$readfd
    [[ "$bytes" =~ \{([0-9]{1,})\} ]] && bytes="${breg[1]}"
    read -rN $bytes message <&$readfd
    while read -r line; do
	if [[ "$line" =~ " OK " ]]; then break; fi
	if [[ "$line" =~ " BAD "|" NO " ]]; then
	    draw_popup --warn --restore $1 "Failed to retrieve message"
	fi
    done <&$readfd
    while read -r line; do
	open_message[count]="$line"
	(( count++ ))
    done < <(echo "$message")
    if [[ "${struct[encoding]}" == "none" ]]; then
	parse_plain_links
	parse_html
	message_cleanup_whitespace
	print_message $1
    elif [[ "${struct[encoding]}" == "qp" ]]; then
	decode_qp --message
	parse_plain_links
	message_cleanup_whitespace
	print_message $1
    fi
}

# $1: namespace $2: index
function decode_b64() {
    local -n arr=$1
    full_string="${arr[$2]}"
    full_string="${full_string//$'\n'/}"
    [[ ! "$full_string" =~ \?= ]] && echo "End of Base64 not found"
    # Group 1: Plain text before first "=?"
    # Group 2: Base 64 encoded text found after "=?UTF-8?B?" and before "?="
    # Group 3: Any text after "?=" except if it starts with a space or "<"
    if [[ "$full_string" =~ ^[[:space:]]?([^=]*)=\?.{5}\?B\?([^\?]{1,})\?=([^\<[:space:]]*) ]]; then
	plain_pre="${breg[1]}"
	plain_post="${breg[3]}"
	encoded="${breg[2]//$'\n'/}"
	decoded=$(echo "$encoded"|base64 -d 2>/dev/null)
	if (( ${#plain_pre} > 0 )); then
	    if (( ${#plain_post} > 0 )); then
		echo "$plain_pre$decoded$plain_post"
	    else
		echo "$plain_pre$decoded"
	    fi
	else
	    echo "$decoded"
	fi
    fi
}

function decode_qp() {
    # $1: Flags. Either "--message" or "--header"
    # $2 is only used to provide either $from_arr or $subject_arr index
    clearfifo
    # Decode the whole messsage line by line
    if [[ "$1" == "--message" ]]; then
	for (( i=0;i<${#open_message[@]};i++ )); do
	    open_message[i]=$(echo "${open_message[$i]}"\
				   |sed -r 's/=([A-Za-z0-9]{2})/\\x\1/g;s/=//g')
	done
    # Header QP. $2 Passes in an index from an array
    elif [[ "$1" == "--header" ]]; then
	string="${2//$'\n'/}"
	[[ "$string" =~ ^" "?([^=]*) && ${#breg} -gt 0 ]] && string_pre_qp="$breg[1]"
	[[ "$string" =~ " "?[^=]*=\?.{5}\?Q\?(.*)\?= ]] && string_qp="${breg[1]//@(=\?UTF-8\?Q\?|\?=|$'\n')/}"
	if [[ -v string_qp && ${#string_qp} -gt 0 ]]; then
	    regex="=([A-Za-z0-9]{2})"
	    qp_message=$(echo "$string_qp"|sed -r "s/_/ /g; s/$regex/\\\x\1/g")
	    [[ -v string_pre_qp ]] && echo -e "$string_pre_qp$qp_message"\
		    || echo -e "$qp_message"
	else
	    echo "Failed to decode text"
	fi
    fi
}

function parse_html() {
    clearfifo
    for (( i=0;i<${#open_message[@]};i++ )); do
	open_message[i]=$(echo "${open_message[$i]}"\
			       |sed -r 's/<br>/\n/g; s/<\/?.*>//g')
    done
}

function parse_plain_links() {
    for (( i=0;i<${#open_message[@]};i++ )); do
	open_message[i]=$(echo "${open_message[$i]}"\
	  |sed -r "s/[(<]?.?(https?|mailto).*[)>[:blank:]]?/\\${BrB}Link\\$reset/g")
    done
}

function message_cleanup_whitespace() {
    # Any groups of 3 or more consecutive new lines, reduce to 2
    for (( i=0;i<${#open_message[@]};i++ )); do
	if [[ "${open_message[$i]}" =~ ^$'\n' &&\
		  "${open_message[$i+1]}" =~ ^$'\n' &&\
		  "${open_message[$i+2]}" =~ ^$'\n' ]]; then
	    unset "open_message[$i+2]"
	fi
    done
}

function print_message() {
    # $1 --unread or --inbox
    reset_colors
    reset_scroll_area
    clear
    for (( i=0;i<lines;i++ )); do
	if [[ -v open_message[$i] ]]; then
	    set_cursor $i 0
	    echo -en "${open_message[$i]}"
	    
	else
	    break
	fi
    done
    open_message_range[top]=0
    open_message_range[bottom]=$(( lines - 1 ))
    set_cursor 0 0
    message_line_pos=1
    mode="message"
    show_cursor
    message_nav_mode $1
}
