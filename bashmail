function splash_forward_line() {
    (( LP++ ))
    set_cursor $LP $splashstart
}

function inbox_list_forward() {
    # Either 0 args, or flag "--unread"
    if [[ "$1" == "--unread" ]]; then
	local -n arr_range=unread_range
	local -n header_arr=UHA
	local -i count=$unreadcount
    elif [[ "$1" == "--inbox" ]]; then
	local -n arr_range=inbox_range
	local -n header_arr=IHA
	local -i count=$inboxcount
    fi
    if (( count > 1 )); then
	linesum=$(( 2 + LP ))
	# Wrap at last message if all messages are shown
	if (( linesum > LLP && count <= max_shown )); then
	    set_cursor $FLP 1
	    PLP=$LP
	    PIAC=$IAC
	    IAC=${arr_range[top]}
	    LP=$FLP
	    highlight $1
	    update_bottom_bar $1
        # Only redraw bottom line when the last 2 indexes of
	# header_arr != arr_range[bottom]
	elif (( linesum >= bottomline && arr_range[bottom] < ${#header_arr[@]}-2 )); then
	    PLP=$(( max_inbox_line - 2 ))
	    LP=$max_inbox_line
	    (( arr_range[top]+=2 ))
	    (( arr_range[bottom]+=2 ))
	    PIAC=$IAC
	    (( IAC+=2 ))
	    highlight $1
	    update_bottom_bar $1
	elif (( IAC < arr_range[bottom] )); then
	    set_cursor $linesum 1
	    PLP=$LP
	    (( LP += 2 ))
	    PIAC=$IAC
	    (( IAC+=2 ))
	    highlight $1
	    update_bottom_bar $1
	fi
    fi
}

function inbox_list_backward() {
     if [[ "$1" == "--unread" ]]; then
	local -n arr_range=unread_range
	local -i count=$unreadcount
    elif [[ "$1" == "--inbox" ]]; then
	local -n arr_range=inbox_range
	local -i count=$inboxcount
     fi
     if (( count > 1 )); then
	 linesum=$(( LP - 2 ))
	 # Wrap at first message
	 if (( linesum < FLP && count <= max_shown )); then
	     set_cursor $max_inbox_line 1
	     PLP=$LP
	     LP=$LLP
	     PIAC=$IAC
	     IAC=${arr_range[bottom]}
	     highlight $1
	     update_bottom_bar $1
	 elif (( linesum < FLP && arr_range[top] != 0 )); then
	     PLP=$(( FLP + 2 ))
	     LP=$FLP
	     (( arr_range[top]-=2 ))
	     (( arr_range[bottom]-=2 ))
	     PIAC=$IAC
	     (( IAC-=2 ))
	     highlight $1
	     update_bottom_bar $1
	 elif (( linesum >= FLP )); then
	     set_cursor $linesum 1
	     PLP=$LP
	     (( LP -= 2 ))
	     PIAC=$IAC
	     (( IAC-=2 ))
	     highlight $1
	     update_bottom_bar $1
	 fi
     fi
}

