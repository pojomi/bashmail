function clearfifo() {
    while read -r -t 0.5 line; do
	continue
    done <&$readfd
}

function get_folders() {
    # Store the server's folder names in an associative array for
    # easy access when needed
    [[ "$email" =~ "gmail.com" ]] && folder[archived]="\"[Gmail]/All Mail\""
    echo "$A LIST \"\" \"*\"" >&$sendfd # Response is a list of all folders
    while read -r line; do
	[[ "$line" =~ " OK " ]] && break
	[[ "$line" =~ " BAD "|" NO " ]] && draw_popup --warn "Failed to get folders\nInbox/Unread available" && break
	if [[ "$line" =~ \"[Aa]rchive\"|\"[Aa]rchived\" ]]; then
	    folder[archived]="${breg//[$'\n'|$'\r']/}"
	fi
	if [[ "$line" =~ \\Trash[^\"]*\"[^\"]*\"[^\"]*(\".*\") ]]; then
	    folder[trash]="${breg[1]//[$'\n'|$'\r']/}"
	fi
	if [[ "$line" =~ \\Junk[^\"]*\"[^\"]*\"[^\"]*(\".*\")|(\"[Jj]unk\") ]]; then
	    if [[ -n "${breg[1]}" ]]; then
		folder[junk]="${breg[1]//[$'\n'|$'\r']/}"
	    elif [[ -n "${breg[2]}" ]]; then
		folder[junk]="${breg[2]//[$'\n'|$'\r']/}"
	    fi
	fi
    done <&$readfd
}
	   
function select_inbox() {
    # 0 args check is the initial call only
    [ $# -eq 1 ] && reset_indexes ILTH IHTL IHA && echo "$A UNSELECT" >&$sendfd
    clearfifo
    echo "$A SELECT INBOX" >&$sendfd
    while read -r line; do
	if [[ "$line" =~ "$A OK " ]]; then
	    if [ $# -eq 0 ]; then
		hide_mode_off
		echo "Inbox selected"
		splash_forward_line
		hide_mode
	    fi
	    break
	elif [[ "$line" =~ ([0-9]{1,})" "EXISTS|([0-9]{1,})" "exists ]]; then
	    inbox_newest_id="${breg[1]}"
	elif [[ "$line" =~ " BAD "|" NO " ]]; then
	    draw_popup --error "Failed to open inbox"
	    exit
	fi
    done <&$readfd
}

function get_unread_messages() {
    # Send request to server for list of unread message IDs
    # Store in array $ULTH (low-to-high numbering) and $UHTL (high-to-low)
    clearfifo
    echo "$A SEARCH UNSEEN" >&$sendfd
    while read -r line; do
	[[ "$line" =~ " OK " ]] && break
	[[ "$line" =~ " BAD "|" NO " ]] && draw_popup --error "Failed unread search"
	if [[ "$line" =~ SEARCH" "([0-9].*) ]]; then
	    id_str="${breg[1]//$'\r'/}"
	    IFS=" "
	    ULTH=($(echo -n "${id_str//[$'\r'|$'\n']/}"))
	    UHTL=($(sort_array ULTH -nr))
	    unset IFS
	    unread_str="${id_str// /,}"
	    unreadcount=${#ULTH[@]}
	    # Store the terminal line numbers
	    # First Line Position
	    FLP=2
	    # The last line position is equivalent to the last index number of
	    # UHA and IHA
	    LLP=$(( unreadcount * 2 ))
	    LP=2
	    PLP=0
	fi
    done <&$readfd
}

function reset_indexes() {
    # Unset all indexes of any passed array names
    # Args should be strings not prefixed with "$"
    for i in $(seq 1 $#); do
	# Expand $i with ${!i} to get the string from $1,2,3...
	local -n arg_arr=${!i}
	if [[ "$(declare -p ${!i})" == "declare -a"* ]]; then
	    unset "arg_arr[@]"
	elif [[ "$(declare -p ${!i})" == "declare -A"* ]]; then
	    IFS=" "; local -a keys=($(echo "${!arg_arr[@]}")); unset IFS;
	    for (( j=0; j<${#keys[@]}; j++ )); do
		unset "arg_arr[${keys[j]}]"
	    done
	fi
    done
}

function fetch_header_field() {
    clearfifo
    echo "$A FETCH $1 body.peek[header.fields (from subject)]" >&$sendfd
    i=0
    while read -rs line; do
	if [[ "$line" =~ " OK " ]]; then break; fi
	if [[ "$line" =~ " BAD "|" NO " ]]; then draw_popup --error "Failed to retrieve headers"; fi
	# Bytes are found on first line in "{0-9}"
	if [[ "$line" =~ \{[0-9]+\} ]]; then
	    local -i bytes
	    bytes=$(echo "${breg//["{"|"}"|$'\n']/}")
	    if (( bytes > 0 )); then
		read -rN $bytes body <&$readfd
		regex1="[Ff]rom: (.*)[Ss]ubject"
		regex2="[Ff]rom: (.*)"
		# From and Subject can come in random order, so check both possibilities
		if [[ "$body" =~ $regex1 || "$body" =~ $regex2 ]]; then
		    regval="${breg[1]//[$'\n'|\"]/}"
		    regex="^[[:space:]]?([^\<]{1,})"
		    if [[ "$regval" =~ $regex ]]; then
			from_arr[i]="${breg[1]//[$'\r'|$'\n']/}"
		    else
			from_arr[i]="${regval//[$'\r'|$'\n'|<|>]/}"
		    fi
		    regex1="[Ss]ubject: (.*)[Ff]rom"
		    regex2="[Ss]ubject: (.*)"
		    if [[ "$body" =~ $regex1 || "$body" =~ $regex2 ]]; then
			subject_arr[i]="${breg[1]//[$'\n'\"$'\r']/}"
		    fi
		    (( i++ ))
		fi
	    fi
	fi
    done <&$readfd
}

function parse_headers() {
    if [[ "$1" == "--unread" ]]; then
	local -i count=$unreadcount
    elif [[ "$1" == "--inbox" ]]; then
	local -i count=$inboxcount
    fi
    for (( i=0;i<count;i++ )); do
	if [[ "${from_arr[i]}" =~ \?[Bb]\? ]]; then
	    from_arr[i]=$(decode_b64 from_arr $i);
	fi
	if [[ "${from_arr[i]}" =~ \?[Qq]\? ]]; then
	    from_arr[i]=$(decode_qp --header "${from_arr[i]}");
	fi
	if [[ "${subject_arr[i]}" =~ \?[Bb]\? ]]; then
	    subject_arr[i]=$(decode_b64 subject_arr $i);
	fi
	if [[ "${subject_arr[i]}" =~ \?[Qq]\? ]]; then
	    subject_arr[i]=$(decode_qp --header "${subject_arr[i]}");
	fi
    done
}

function combine_headers() {
    # After parsing, join $from_arr and $subject_arr into one array ($UHA)
    # Alternating indexes. (Ex: 0 is From, 1 is Subject, 2 is From, 3 is Subject)
    if (( ${#from_arr[@]} == ${#subject_arr[@]} )); then
	local -i indexes=$(( ${#from_arr[@]} + ${#subject_arr[@]} ))
	local -n arr=$2
	for (( i=0;i<indexes;i+=2 )); do
	    arr[i]="${from_arr[-1]}"
	    unset from_arr[-1]
	    arr[i+1]="${subject_arr[-1]}"
	    unset subject_arr[-1]
	done
    fi
}



function draw_popup() {
    # Args: flags precede strings
    # --[warn|error] --[reload] --[unread|inbox] "[text]"
    local args=("$@")
    local -i longest_line longest_line_center box_rows box_columns box_center\
	  tty_start_col tty_start_line
    local warn_colors error_colors default_colors colors
    warn_colors="$Ybg$Black$Bold"
    error_colors="$Rbg$Black$Bold"
    default_colors="$Gbg$Black$Bold"

    case "$args" in
	*"--error"*) colors="$error_colors";;
	*"--warn"*) colors="$warn_colors";;
	*) colors="$default_colors";;
    esac

    IFS=$'\n'
    local -a message=($(echo -e "${!#}")) # If multiline, store lines in indexes
    unset IFS
    # Find longest line from message
    longest_line=${#message[0]}
    for (( i=0;i<${#message[@]};i++ )); do
	if (( longest_line <= ${#message[i]} )); then
	    longest_line=${#message[i]}
	fi
    done
    longest_line_center=$(( longest_line / 2 ))
    box_columns=$(( longest_line + 4 )) # Add 2 for border, 2 for whitespace on ends
    box_rows=$(( 2 + ${#message[@]} ))
    box_center=$(( box_columns / 2 ))
    tty_start_col=$(( columns / 2 - box_center ))
    tty_start_line=$(( lines / 2 - box_rows ))
    set_cursor $tty_start_line $tty_start_col
    reset_colors
    echo -en "$colors"
    for (( i=0;i<box_rows;i++ )); do
	line_len=${#message[i-1]}
	line_center=$(( line_len / 2 ))
	text_start_col=$(( longest_line_center - line_center + (line_len % 2) ))
	text_end_col=$(( text_start_col + line_len ))
	# Top Row
	if (( i == 0 )); then
	    echo -n "╔"
	    for (( j=0;j<box_columns-2;j++ )); do echo -n "═"; done
	    echo -n "╗"
	fi
	# Inner Rows
	if (( i != 0 && i != box_rows-1 )); then
	    echo -n "║"
	    for (( j=0;j<text_start_col;j++ )); do
		echo -n " "
	    done
	    echo -n "${message[i-1]}"
	    for (( j=0;j<box_columns-2-text_end_col;j++ )); do echo -n " "; done
	    echo -n "║"
	fi
	# Bottom Row
	if (( i == box_rows-1 )); then
	    echo -n "╚"
	    for (( j=0;j<box_columns-2;j++ )); do echo -n "═"; done
	    echo -n "╝"
	fi
	(( tty_start_line++ ))
	set_cursor $tty_start_line $tty_start_col
    done
    if [[ "${args[@]:1}" =~ "--restore" ]]; then
	# Any keypress will close or 1.5s timeout
	read -rsn 1 -t 1.5
	draw_inbox $3 --restore; highlight $3
    fi
    reset_colors; set_cursor $LP 1
    if [[ "${args[@]}" == *"--error"* ]]; then
	read -rsn 1 -t 1.5
	exit
    fi
}

function draw_inbox() {
    reset_colors
    clear
    hide_cursor
    set_scroll_area 2 36
    update_top_margin "$1"
    if [[ "$1" == "--unread" ]]; then
	local -n arr_range=unread_range
	local -n header_arr=UHA
	local -n ids_arr=ULTH
    elif [[ "$1" == "--inbox" ]]; then
	local -n arr_range=inbox_range
	local -n header_arr=IHA
	local -n ids_arr=ILTH
    fi

    local -i count=${#header_arr[@]}
    [ $count -gt $max_inbox_line ] && local -i limit=$bottomline ||\
	    local -i limit=$count

    if [[ "$2" == "--restore" ]]; then
	local -i arr_index
	set_cursor $FLP 1
	for (( i=arr_range[top];i<arr_range[bottom]+2;i+=2 )); do
	    reset_colors
	    echo -e " $R${header_arr[i]}"; reset_colors
	    echo -e " $Y${header_arr[i+1]}"
	done
	set_cursor $LP 1
	if [[ -n "$bottom_text" ]]; then
	    set_bottom_bar $1
	fi
	return
    fi
	
    arr_range[top]=0
    for (( i=arr_range[top]; i<limit; i+=2 )); do
	reset_colors
	echo -e " $R${header_arr[i]}"
	reset_colors
	if (( i+1 == count )); then
	    echo -en " $Y${header_arr[i+1]}"
	else
	    echo -e " $Y${header_arr[i+1]}"
	fi
    done
    arr_range[bottom]=$(( i - 2 ))
    IAC=0
    PIAC=0
    LP=2
    PLP=0
    set_cursor $LP 1

    if [[ -n "$bottom_text" ]]; then
	set_bottom_bar $1
    fi
}

function switch_to_inbox() {
    draw_popup "Loading inbox"
    select_inbox --reload
    update_top_margin --inbox
    # Retrieve a full page newest->oldest messages from the inbox
    local msg_range
    local -i inbox_id_limit=$(( inbox_newest_id - max_shown ))
    inboxcount=$(( inbox_newest_id - inbox_id_limit ))

    # Comma separated IDs, just like unread
    for (( i=inbox_newest_id;i>inbox_id_limit;i-- )); do
	if (( i-1 == inbox_id_limit )); then
	    msg_range+="$i"
	else
	    msg_range+="$i,"
	fi
    done

    # Also store these IDs in $ILTH
    IFS=','
    # Inbox IDs high-to-low order
    IHTL=($(echo -n "$msg_range"))
    IFS=" "
    # Inbox IDs low-to-high order
    ILTH=($(sort_array IHTL -n))
    unset IFS
    if (( ${#IHA[@]} == 0 )); then
	fetch_header_field "$msg_range"
	parse_headers --inbox
	combine_headers --inbox IHA
	clearfifo
	hide_mode_off
    fi
    # Update $LLP to reflect IHA
    LLP=$(( inboxcount * 2 ))
    draw_inbox --inbox
    set_bottom_bar --inbox
    highlight --inbox
    inbox_nav_mode
}

function refresh_unread() {
    draw_popup "Reloading Unread"
    clearfifo
    reset_indexes marked_messages UHTL ULTH from_arr subject_arr UHA
    reset_colors
    get_unread_messages --reload
    fetch_header_field "$unread_str"
    parse_headers --unread
    combine_headers --unread UHA
    clearfifo
    hide_mode_off
    draw_inbox --unread
    set_bottom_bar --unread
    highlight --unread
    unread_nav_mode
}

