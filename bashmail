}

# To print the visibly highlighted index
function bottom_msg_at_cursor() {
    if [[ "$1" == "--unread" ]]; then
	local -n arr_range=unread_range
    elif [[ "$1" == "--inbox" ]]; then
	local -n arr_range=inbox_range
    fi
    echo $(( (arr_range[top] + LP) / 2 ))
}

function set_bottom_bar() {
    [[ "$1" == "--unread" ]] && bottom_text="($(bottom_msg_at_cursor $1)/$unreadcount)"
    [[ "$1" == "--inbox" ]] && bottom_text="($(bottom_msg_at_cursor $1)/$inboxcount)"
    bottom_unused_cols=$(( columns - ${#bottom_text} - 1 ))
    set_cursor $bottomline 1
    erase_line
    echo -en "$Rbg$Black$Bold $bottom_text"
    for (( i=0; i<bottom_unused_cols; i++ )); do
	echo -n " "
    done
    set_cursor $LP 0
}

function update_bottom_bar() {
    [[ "$1" == "--unread" ]] && local -i count=$unreadcount && bottom_text="($(bottom_msg_at_cursor $1)/$count)"
    [[ "$1" == "--inbox" ]] && local -i count=$inboxcount && bottom_text="($(bottom_msg_at_cursor $1)/$count)"
    if (( count > 1 )); then
	reset_colors
	hide_cursor
	local -i bottom_text_len=${#bottom_text}
	set_cursor $bottomline 1
	local -i bottom_text_diff=$(( columns - ${#bottom_text} - 1 ))
	if (( bottom_text_diff > 0 )); then
	    for (( i=0; i<bottom_text_diff; i++ )); do
		bottom_text+=" "
	    done
	fi
	echo -en "$Rbg$Black$Bold $bottom_text"
	reset_colors
	set_cursor $LP 0
    fi
}

function highlight() {
    local -i prev_arr_index=$(rel_msg_index $PIAC)
    local -i arr_index=$(rel_msg_index $IAC)
    if [[ "$1" == "--unread" ]]; then
	local -n header_arr=UHA
	local -n id_arr=UHTL
	local -n arr_range=unread_range
    elif [[ "$1" == "--inbox" ]]; then
	local -n header_arr=IHA
	local -n id_arr=IHTL
	local -n arr_range=inbox_range
    fi
    local -i prev_msg_id=${id_arr[prev_arr_index]}
    local -i arr_msg_id=${id_arr[arr_index]}

    # Use AA to store/modify header_arr lines to print
    local -A header_output

    # Add "*" for marked messages
    if $(check_if_marked "$prev_msg_id"); then
	header_output[prev0]="$W*$R${header_arr[PIAC]}"
    else
	header_output[prev0]=" $R${header_arr[PIAC]}"
    fi
    header_output[prev1]=" $Y${header_arr[PIAC+1]}"
    if $(check_if_marked "$arr_msg_id"); then
	header_output[cursor0]="$W*$R$Bbg$Bold${header_arr[IAC]}"
    else
	header_output[cursor0]=" $R$Bbg$Bold${header_arr[IAC]}"
    fi
    header_output[cursor1]=" $Y$Bbg$Bold${header_arr[IAC+1]}"
	
    reset_colors
    # PLP should always be > 0 except on the initial call of draw_inbox()
    if (( PLP > 0 )); then
	# Check if inbox_list_forward/backward wrapped around the list
	reset_colors; set_cursor $PLP 1; erase_line
	echo -e "${header_output[prev0]}"; reset_colors; erase_line
	echo -en "${header_output[prev1]}"; reset_colors;
	reset_colors; set_cursor $LP 1; erase_line
	echo -e "${header_output[cursor0]}"; reset_colors; erase_line
	echo -en "${header_output[cursor1]}"; reset_colors; set_cursor $LP 1
    # Initial draw_inbox() call handler
    else
	set_cursor $LP 1; reset_colors; erase_line
	echo -e "${header_output[cursor0]}"; reset_colors; erase_line
	echo -en "${header_output[cursor1]}"; reset_colors; set_cursor $LP 1
    fi
}

