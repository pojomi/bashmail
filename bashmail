emailenc="$bashmail_dir/.emailenc"
passenc="$bashmail_dir/.passenc"
if ! test -d "$bashmail_dir"; then mkdir "$bashmail_dir"; fi

if ! [[ -f "$emailenc" && -f "$passenc"  ]]; then
    echo -n "Email: "
    read -r email
    echo "$email" | openssl aes-256-cbc -pbkdf2 -pass pass:"bashmailemail"\
